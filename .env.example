# Optional. `sidefleet serve` generates keys on first run and saves them in ~/.sidefleet/server.env,
# so you only need this file to pin your own values.
DATABASE_URL=postgres://sidefleet:sidefleet@localhost:5432/sidefleet
SIDEFLEET_BIND=0.0.0.0:8080
# Bearer key the browser uses for the API.
SIDEFLEET_DEV_KEY=change-me-dev-key
# Token(s) workers present. Comma-separate to issue one per machine.
SIDEFLEET_WORKER_TOKENS=change-me-worker-token
# Optional: RUST_LOG=sidefleet=debug,sidefleet_server=debug,tower_http=info
