# Control plane (acd)
DATABASE_URL=postgres://acd:acd@localhost:5432/acd
ACD_BIND=0.0.0.0:8080
# Bearer key the browser / developer uses for /v1/runs and /v1/workers.
ACD_DEV_KEY=change-me-dev-key
# Token(s) workers present. Comma-separate to issue one per machine.
ACD_WORKER_TOKENS=change-me-worker-token
# Optional: RUST_LOG=acd=debug,tower_http=info

# Worker (acw)
ACW_TOKEN=change-me-worker-token
